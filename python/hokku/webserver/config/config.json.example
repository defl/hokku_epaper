    "saturate_high_chroma_thresh": 15.0,
    "saturate_high_chroma_thresh_oklab": 0.075,
    "saturate_low_chroma_thresh": 5.0,
    "saturate_low_chroma_thresh_oklab": 0.025,
    "saturate_max_enhance": 1.25,
