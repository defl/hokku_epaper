{
  "auto_clear_cache": false,
  "cache_dir": "/var/lib/hokku/cache",
  "classifier_bw_detect_enabled": true,
  "classifier_face_aware_crop_enabled": false,
  "classifier_face_detect_clahe_keepout": true,
  "classifier_face_detect_enabled": true,
  "crop_to_fill_threshold": 0.1,
  "debug_fast_refresh": false,
  "firmware_dir": "/var/lib/hokku/firmware",
  "firmware_github_repo": "defl/hokku_epaper",
  "flash_wifi_pass": "",
  "flash_wifi_pass2": "",
  "flash_wifi_ssid": "",
  "flash_wifi_ssid2": "",
