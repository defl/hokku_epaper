    "tools/phoenixmc_dump.py",
    "tools/phoenixmc_flash.py",
    "tools/phoenixmc_flash_full.py",
    "tools/phoenixmc_flash_oem.py",
    "tools/phoenixmc_inspect.py",
    "tools/phoenixmc_open.py",
    "tools/phoenixmc_read.py",
    "tools/verify_ui.py",
    "tools/_analyze_dll.py",
    "tools/_analyze_ref_dump.py",
    "tools/_baud_scan.py",
    "tools/_brom_changebaud_test.py",
