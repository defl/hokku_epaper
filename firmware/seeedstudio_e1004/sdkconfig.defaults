# Target
CONFIG_IDF_TARGET="esp32s3"

# Flash — XIAO_ESP32S3 as used in clients/reterminal_e1004's Arduino build
# reported 32 MB (see that README's footer). NOT independently re-verified
# for this ESP-IDF port — check `esptool.py flash_id` against real hardware
# before relying on this.
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# Console on UART0 — NOT the same as huessen_epf1301. On this baseboard the
# USB-C port is wired through an external CH340K bridge to UART0 (GPIO43/44),
# not to the SoC's native USB Serial/JTAG peripheral: Windows enumerates the
# device as VID_1A86:PID_7522 (CH340K), never as VID_303A:PID_1001 (native
# USJ). CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y was copied from huessen_epf1301
# without re-verifying this board's physical wiring, and silently routed the
# app console to a peripheral with no path to the host — the ROM banner still
# appeared because ROM boot messages print to UART0 unconditionally,
# independent of this setting, which made it look like a live-then-silent USB
# connection instead of a console pointed at the wrong peripheral entirely.
# Confirmed + fixed on real hardware (issue #14, PR #23 by @TaichungLester).
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# Partition table — A/B OTA (ota_0 / ota_1 / otadata), see partitions.csv.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# OTA rollback: an OTA'd app boots PENDING_VERIFY and must call
# esp_ota_mark_app_valid_cancel_rollback() (done after a successful refresh via
# ota_mark_valid_if_pending); otherwise the bootloader reverts to the previous
# slot on the next boot. Combined with button-wake (an early recovery hatch),
# this satisfies the root AGENTS.md firmware-flashing STOP rules.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Compiler — performance build (-O2), not debug (-Og)
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# CPU — 240 MHz (ESP32-S3 max)
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Chip revision — align with huessen_epf1301's baseline until this board's
# actual silicon revision is confirmed.
CONFIG_ESP32S3_REV_MIN_2=y

# Run code and rodata from PSRAM — eliminates flash/PSRAM XIP cache contention
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y

# Log level
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Main task stack (display + WiFi + HTTP needs headroom)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# PSRAM (8MB octal per Seeed's reTerminal E1004 spec — "PSRAM: OPI PSRAM" is
# mandatory per clients/reterminal_e1004/README.md; the 960 KB frame buffer
# does not fit in internal SRAM)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# WiFi - allocate buffers in SPIRAM when possible
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# DHCP — skip the post-ACK gratuitous-ARP duplicate-address check. On mesh APs
# with client isolation / proxy-ARP the check stalls, so the lease is granted
# by the router but the STA never binds and IP_EVENT_STA_GOT_IP never fires
# (association succeeds, DHCP ACK arrives, then bind hangs). Disabling it makes
# the STA bind immediately on ACK. (Proven on huessen hardware; identical fix.)
CONFIG_LWIP_DHCP_DOES_NOT_CHECK_OFFERED_IP=y
